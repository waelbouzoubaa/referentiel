# ── Base de données ──────────────────────────────────────────────────────────
MIDDLEWARE_DATABASE_URL=postgresql+asyncpg://middleware:middleware@localhost:5432/middleware
MIDDLEWARE_DATABASE_ECHO=false

# ── Stockage objet (MinIO en dev, GCS en prod) ───────────────────────────────
MIDDLEWARE_STORAGE_ENDPOINT=http://localhost:9000
MIDDLEWARE_STORAGE_BUCKET=middleware-dev
MIDDLEWARE_STORAGE_ACCESS_KEY=minioadmin
MIDDLEWARE_STORAGE_SECRET_KEY=minioadmin
# En prod GCS : laisser endpoint vide et utiliser les credentials GCP

# ── Application ──────────────────────────────────────────────────────────────
MIDDLEWARE_DEBUG=false
MIDDLEWARE_LOG_LEVEL=INFO
MIDDLEWARE_ENVIRONMENT=development

# ── Dossiers locaux (dev) ────────────────────────────────────────────────────
MIDDLEWARE_INPUT_FOLDER=/data/input
MIDDLEWARE_OUTPUT_FOLDER=/data/output

# ── SharePoint Watcher ───────────────────────────────────────────────────────
TENANT_ID=
CLIENT_ID=
CLIENT_SECRET=
SHAREPOINT_HOST=maikhub.sharepoint.com
SHAREPOINT_SITE_PATH=/sites/test2
POLL_INTERVAL=300
# Colonne SharePoint (choix Oui/Non) qui indique qu'un fichier est prêt à être traité.
# Tant qu'elle vaut "Non" (ou est vide), le watcher l'ignore.
TAG_COLUMN_NAME=Export Gery
TAG_COLUMN_READY_VALUE=Oui

# ── IA (Gemini) ──────────────────────────────────────────────────────────────
GEMINI_API_KEY=

# ── Notification email (demande d'aide support) ──────────────────────────────
# Laisser MIDDLEWARE_SMTP_HOST ou MIDDLEWARE_SUPPORT_NOTIFY_EMAIL vide désactive
# l'envoi (best-effort — n'empêche jamais l'escalade elle-même).
# URL publique de l'interface de validation, incluse dans l'email (lien cliquable).
MIDDLEWARE_REVIEW_UI_URL=https://refs-fournisseurs.devtools.maikhub.com/
MIDDLEWARE_SMTP_HOST=
MIDDLEWARE_SMTP_PORT=587
MIDDLEWARE_SMTP_USER=
MIDDLEWARE_SMTP_PASSWORD=
MIDDLEWARE_SMTP_FROM=
MIDDLEWARE_SMTP_USE_TLS=true
MIDDLEWARE_SUPPORT_NOTIFY_EMAIL=
